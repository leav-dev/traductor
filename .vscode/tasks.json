{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake -B build"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build -j",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "dependsOn": ["configure"]
    }
  ]
}
